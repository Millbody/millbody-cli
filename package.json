{
  "name": "@millbody/millbody-cli",
  "version": "2.0.1",
  "description": "Um CLI para projetos usando o framework gym.Millbody",
  "main": "src/cli.js",
  "type": "module",
  "bin": {
    "millbody": "bin/millbody"
  },
  "files": [
    "bin",
    "src",
    "scripts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=23"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "test": "node --test --experimental-test-module-mocks test/*.test.js",
    "test:coverage": "node --test --experimental-test-module-mocks --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=90 --test-coverage-exclude='test/**' --test-coverage-exclude='**/millbody-api-test-*/**' --test-coverage-exclude='**/millbody-sandbox-*/**' test/*.test.js"
  },
  "keywords": [
    "cli",
    "millbody",
    "framework",
    "gym"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@inquirer/prompts": "^5.3.8",
    "arg": "^4.1.2",
    "ttab": "^0.7.1"
  },
  "devDependencies": {
    "eslint": "^9.39.5"
  },
  "overrides": {
    "tmp": "^0.2.6"
  },
  "resolutions": {
    "tmp": "^0.2.6"
  }
}
